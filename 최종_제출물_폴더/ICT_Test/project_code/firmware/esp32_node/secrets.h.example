#ifndef ESP32_NODE_CREDENTIALS_H
#define ESP32_NODE_CREDENTIALS_H
/*
 * esp32_node 예시 설정 — 펌웨어 설계서 §7.4. 이 파일을 같은 폴더에 secrets.h 로
 * 복사한 뒤 값을 채운다. secrets.h 는 .gitignore 대상이라 저장소에 커밋하지
 * 않는다(CLAUDE.md §1-2). 여기 예시 파일만 저장소에 둔다.
 */

#define WIFI_SSID      "your-wifi-name"
#define WIFI_PSK       "your-wifi-passphrase"

/* 게이트웨이(PC)에서 run.py 가 여는 TCP 리스너. simulate=5556 / hardware 는
 * --socket-port 로 지정. ESP32 는 이 주소로 접속하는 TCP 클라이언트다. */
#define GATEWAY_HOST   "192.168.0.10"
#define GATEWAY_PORT   5556

#endif /* ESP32_NODE_CREDENTIALS_H */
